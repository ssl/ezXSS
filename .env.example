# ezXSS 5.0 — environment configuration template.

# Application
DEBUG=false
DOMAIN=localhost
TIMEZONE=UTC

# Database (MySQL / MariaDB)
# Docker default: host=db, user=ezxss (the compose `db` service).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ezxss
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Access control
# IP_LOCK=true restricts access to ALLOWED_IPS (comma-separated, exact or prefix match).
IP_LOCK=false
ALLOWED_IPS=

# Authentication
# SESSION_TTL: panel session token lifetime in seconds (default 7 days).
SESSION_TTL=604800
# PANEL_DOMAINS: extra hosts (no scheme, comma-separated) allowed to serve the panel
PANEL_DOMAINS=
# PANEL_PATH: URL path of the panel (default manage, so /manage). Letters, digits, - and _ only.
PANEL_PATH=manage

# Reverse proxy / CDN
# Set to true when behind Cloudflare or another reverse proxy so the app reads
# the real client IP from X-Forwarded-For / CF-Connecting-IP.
TRUST_PROXY=false

# ── Docker only ──────────────────────────────────────────────────────
# Host port mappings (ignored outside Docker).
HTTP_PORT=80
HTTPS_PORT=443
# Set to true to attempt a Let's Encrypt certificate on boot (requires a real,
# publicly resolvable DOMAIN with ports 80/443 reachable).
INSTALL_CERTIFICATE=false
